# Local development environment variables for Exoverse
# Copy this file to .env for local overrides. Never commit .env files.

# MySQL 8.4 LTS (used by infrastructure/docker/docker-compose.yml and backend local profile)
MYSQL_DATABASE=exoverse
MYSQL_USER=exoverse
MYSQL_PASSWORD=exoverse_dev_password
MYSQL_ROOT_PASSWORD=exoverse_root_password
MYSQL_PORT=3306

# Spring Boot Backend
DB_URL=jdbc:mysql://localhost:3306/exoverse?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=exoverse
DB_PASSWORD=exoverse_dev_password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
